# OpenMRS Docker Compose Environment Configuration
# Copy this file to .env and set values before running docker-compose up

# ─── Database Configuration ───────────────────────────────────────────────────
OMRS_DB=mariadb
OMRS_DB_HOSTNAME=db
OMRS_DB_NAME=openmrs
OMRS_DB_USER=openmrs
OMRS_DB_PASSWORD=CHANGE_ME
OMRS_DB_ROOT_PASSWORD=CHANGE_ME
OMRS_DB_USERNAME=openmrs

# ─── Application Configuration ────────────────────────────────────────────────
OMRS_ADMIN_USER_PASSWORD=CHANGE_ME
OMRS_ADMIN_PASSWORD_LOCKED=true

# ─── Container image tag (for pre-built images) ──────────────────────────────
TAG=nightly

# ─── Development overrides (docker-compose.override.yml) ─────────────────────
# OMRS_DEV_DEBUG_PORT=8000
# OMRS_CREATE_TABLES=true
# OMRS_BUILD=true
# OMRS_BUILD_GOALS=
# OMRS_BUILD_ARGS=

# ─── JobRunr dashboard (docker-compose.override.yml) ─────────────────────────
# OMRS_EXTRA_JOBRUNR_DASHBOARD_ENABLED=true
# OMRS_EXTRA_JOBRUNR_DASHBOARD_PASSWORD=CHANGE_ME
# OMRS_EXTRA_JOBRUNR_DASHBOARD_PORT=9000

# ─── Optional: JVM tuning (override Dockerfile defaults) ─────────────────────
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC

# ─── Optional: Search backend (docker-compose.es.yml) ────────────────────────
# OMRS_SEARCH=elasticsearch
